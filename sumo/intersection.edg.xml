<?xml version="1.0" encoding="UTF-8"?>
<edges>
    <!-- Each approach has an incoming edge (toward J001) and outgoing edge (away from J001) -->
    <!-- 3 fully dedicated lanes per direction: lane 0 = right-turn only,
         lane 1 = through only, lane 2 = left-turn only. No lane sharing at all,
         eliminating any ambiguity or unwanted merging between movement types. -->

    <!-- North approach -->
    <edge id="N_in" from="N_end" to="J001" numLanes="3" speed="13.9" priority="1"/>
    <edge id="N_out" from="J001" to="N_end" numLanes="3" speed="13.9" priority="1"/>

    <!-- South approach -->
    <edge id="S_in" from="S_end" to="J001" numLanes="3" speed="13.9" priority="1"/>
    <edge id="S_out" from="J001" to="S_end" numLanes="3" speed="13.9" priority="1"/>

    <!-- East approach -->
    <edge id="E_in" from="E_end" to="J001" numLanes="3" speed="13.9" priority="1"/>
    <edge id="E_out" from="J001" to="E_end" numLanes="3" speed="13.9" priority="1"/>

    <!-- West approach -->
    <edge id="W_in" from="W_end" to="J001" numLanes="3" speed="13.9" priority="1"/>
    <edge id="W_out" from="J001" to="W_end" numLanes="3" speed="13.9" priority="1"/>
</edges>
